LookAt 0 2 12   0 0 0   0 1 0
Camera "perspective" "float fov" [30]

Film "rgb"
    "integer xresolution" [600] "integer yresolution" [600]
    "string filename" ["broken_normals.exr"]

Sampler "halton" "integer pixelsamples" [64]
Integrator "volpath"

WorldBegin

# Point light
LightSource "point"
    "point3 from" [5 5 5]
    "rgb I" [200 200 200]

# Ground plane
AttributeBegin
    Translate 0 -0.5 0
    Rotate -90 1 0 0
    Material "diffuse" "rgb reflectance" [0.5 0.5 0.5]
    Shape "trianglemesh" 
        "integer indices" [ 0 1 2  0 2 3 ]
        "point3 P" [ -5 -5 0   5 -5 0   5 5 0   -5 5 0 ]
AttributeEnd

# Object
AttributeBegin
    # Non-uniform scale (Flattened on Y, stretched on X)
    Scale 3.0 0.5 1.0
    
    Material "diffuse" "rgb reflectance" [0.25 0.6 0.9]
    Shape "sphere" "float radius" [1]
AttributeEnd