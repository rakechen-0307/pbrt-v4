LookAt 0 0 -3   # Camera position
       0 0 0    # Looking at origin
       0 1 0    # Up vector

Camera "perspective" "float fov" [40]

Sampler "halton" "integer pixelsamples" [64]
Integrator "path"
Film "rgb" "string filename" ["osl_output.png"] 
    "integer xresolution" [800] "integer yresolution" [800]

WorldBegin

# A simple white light
LightSource "distant" "point3 from" [0 5 -5] "point3 to" [0 0 0] 
    "rgb L" [5 5 5]

# ----------------------------------------------------
# 1. Evaluate your OSL noise as a Float
# ----------------------------------------------------
Texture "my_noise_float" "float" "osl"
    "string filename" "test_pattern" 

# ----------------------------------------------------
# 2. Wrap it into a Spectrum using PBRT's "scale" node
# ----------------------------------------------------
Texture "my_noise_color" "spectrum" "scale"
    "texture scale" [ "my_noise_float" ]
    "rgb tex" [ 1 1 1 ]  # We scale pure white by the noise value

# Apply the spectrum version to the diffuse material
Material "diffuse" "texture reflectance" [ "my_noise_color" ]

# Draw a sphere
Shape "sphere" "float radius" [1]